# Carries the app's family room between the two gateways: scripts/household-app-relay.py.
#
# Started by household-app-relay.path whenever either gateway's household-app outbox
# changes, and by household-app-relay.timer every fifteen seconds as the backstop for a
# change that landed while a run was already going. One unit for both, so systemd never
# runs two at once.
#
# Runs on the host rather than in either gateway, so neither assistant can reach the
# relay's own record of what it has carried, and it reads each gateway's state without
# writing into it: delivery goes through relay-in.mjs inside the receiving container.
#
# Lives at /etc/systemd/system/household-app-relay.service on the box.

[Unit]
Description=Carry the app's family room between the two household gateways
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/household-assistant/app-relay/household-app-relay.py tick
# A run makes at most 20 rounds of two deliveries, each bounded at 60 seconds by
# DELIVERY_TIMEOUT_SECONDS: 2400 seconds is the worst case, and this is the backstop
# for a run that stopped making progress, not the budget for one that works.
TimeoutStartSec=2500
# SIQsermon is this host's primary tenant, so the relay yields CPU under contention,
# as the coordination relay does.
Nice=10
