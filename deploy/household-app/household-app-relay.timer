# The backstop for household-app-relay.path: a change written while a run was already
# going does not start another, so this catches it within fifteen seconds. A run that
# finds nothing new costs two small file reads.
#
# Lives at /etc/systemd/system/household-app-relay.timer on the box.

[Unit]
Description=Carry the app's family room on a timer as well

[Timer]
OnBootSec=60s
OnUnitActiveSec=15s
AccuracySec=1s
Unit=household-app-relay.service

[Install]
WantedBy=timers.target
