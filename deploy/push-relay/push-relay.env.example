# /etc/push-relay/push-relay.env on the publisher's box, root-only (mode 0600).
# The values below are placeholders. The real key never goes in the repository or in a
# chat: write it on the box itself (docs/deploy/push-relay.md, "Setting up the relay").
APNS_KEY_ID=ABC123DEFG
APNS_TEAM_ID=TEAM123456
# The .p8 key's PEM text on one line, each line break written as \n.
APNS_PRIVATE_KEY=<the .p8 key>
APNS_TOPIC=com.siqstack.stewardai
PUSH_RELAY_HOUSEHOLDS=/etc/push-relay/households.json
PUSH_RELAY_HOST=127.0.0.1
PUSH_RELAY_PORT=8787
PUSH_RELAY_PER_MINUTE=120
