# The host side of the group surface. One instance per subcommand:
#   household-coordination@tick.service   carries what is waiting
#   household-coordination@plan.service   one proactive planner run
#
# Runs on the host rather than in either gateway, which is what keeps the turn
# counters, the stop state and the off switch out of reach of the assistants whose
# behaviour they bound. The state lives on a host path, so a
# `docker compose up -d --force-recreate` does not touch it.
#
# Lives at /etc/systemd/system/household-coordination@.service on the box.

[Unit]
Description=Household assistant coordination (%i)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# APPLECAL_PASSWORD, for the shared-calendar read the planner does. Root-only, mode
# 0600, and the same file the gateway already reads. Nothing here prints it.
EnvironmentFile=/etc/household-assistant/openclaw.env
Environment=PYTHONPATH=/opt/household-assistant/coordination
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/household-assistant/coordination/coordination-daemon.py %i
# The backstop for a run that has stopped making progress, not the budget for one
# that is working. Type=oneshot means this covers the whole ExecStart, and both
# instances share it, so it has to clear the slower of the two.
#
# A plan run, worst case, in seconds:
#   180   shared_calendar, the CalDAV read       (coordination-daemon.py)
#   900   research, one agent turn               (coordination-daemon.py)
#   600   post_to_group                          (gateways.py, DockerRelayTransport)
#    10   the delivery ack                       (gateways.py, DELIVERY_ACK_SECONDS)
#  ----
#  1690   so 900 killed the weekly run and marked the unit failed.
#
# A tick run, worst case, in seconds:
#  2400   four group posts, two assistants at TURN_CAP 2
#    40   four delivery acknowledgements
#   120   two family-room handovers, one each way      (family_room.py, DockerPeerDelivery)
#  ----
#  2560   plus the group reads and database overhead around every crossing.
#
# 2700 clears the larger worst case with that overhead. Change one of those subprocess
# timeouts or the turn cap and this number needs redoing, which is why the arithmetic
# is here rather than the result.
TimeoutStartSec=2700
# SIQsermon is this host's primary tenant and a live product with a real client, so
# coordination yields CPU under contention. The stop check runs in-process before
# every handoff, so lower priority slows the relay as a whole without putting a stop
# behind a crossing, and a niced tick still lands within its own cadence.
Nice=10
