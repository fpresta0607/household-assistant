# Every fifteen seconds. A person waiting in the group notices a minute; they do not
# notice fifteen seconds, and a tick that finds nothing costs one SQLite read per
# gateway.
#
# Lives at /etc/systemd/system/household-coordination@tick.timer on the box.

[Unit]
Description=Carry household coordination messages

[Timer]
OnBootSec=60s
OnUnitActiveSec=15s
AccuracySec=1s
Unit=household-coordination@tick.service

[Install]
WantedBy=timers.target
